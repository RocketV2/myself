---
import { linePath, steppedPath, linearScale } from '../../lib/charts';
import type { SeriesPoint } from '../../lib/charts';

export interface Tick {
  v: number;
  label: string;
}

interface Props {
  points: SeriesPoint[];
  yTicks: Tick[];
  ariaLabel: string;
  /** 情绪周期用阶梯线（先横后竖） */
  stepped?: boolean;
  height?: number;
  width?: number;
}

const { points, yTicks, ariaLabel, stepped = false, height = 220, width = 640 } = Astro.props;

const M = { top: 18, right: 14, bottom: 36, left: 38 };
const plotW = width - M.left - M.right;
const plotH = height - M.top - M.bottom;
const yMin = Math.min(...yTicks.map((t) => t.v));
const yMax = Math.max(...yTicks.map((t) => t.v));
const xFor = (i: number) => M.left + (points.length <= 1 ? plotW / 2 : (i / (points.length - 1)) * plotW);
const yFor = linearScale([yMin, yMax], [M.top + plotH, M.top]);
const pts = points.map((p, i) => ({ x: xFor(i), y: yFor(p.value) }));
const d = stepped ? steppedPath(pts) : linePath(pts);

// 相位标注只标每个 run 的起点（stepped 模式），避免相邻点拥挤
const runStarts: number[] = [];
if (stepped) {
  points.forEach((p, i) => {
    if (i === 0 || p.sub !== points[i - 1]?.sub) runStarts.push(i);
  });
}
---

{points.length > 0 && (
  <figure class="chart" role="img" aria-label={ariaLabel}>
    <svg viewBox={`0 0 ${width} ${height}`} role="presentation" aria-hidden="true">
      {yTicks.map((t) => {
        const y = yFor(t.v);
        return (
          <>
            <line x1={M.left} y1={y} x2={width - M.right} y2={y} class="grid-line" />
            <text x={M.left - 8} y={y + 4} class="tick" text-anchor="end">{t.label}</text>
          </>
        );
      })}
      <path d={d} class="series" />
      {pts.map((pt) => <circle cx={pt.x} cy={pt.y} r="3" class="mark" />)}
      {stepped &&
        runStarts.map((i) => (
          <text x={pts[i]!.x} y={Math.max(12, pts[i]!.y - 9)} class="phase" text-anchor="middle">
            {points[i]!.sub}
          </text>
        ))}
      {points.map((p, i) => (
        <text x={pts[i]!.x} y={height - 14} class="xlabel" text-anchor="middle">
          {p.label}
        </text>
      ))}
    </svg>
    <details class="chart-data">
      <summary>数据表</summary>
      <table>
        <tbody>
          {points.map((p) => (
            <tr>
              <th scope="row">{p.label}</th>
              <td>{p.sub ? `${p.sub}（第${Math.round(p.value % 10)}天）` : p.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  </figure>
)}

<style>
  .chart {
    margin: 0;
    width: 100%;
  }

  .chart svg {
    width: 100%;
    height: auto;
  }

  .grid-line {
    stroke: var(--line);
    stroke-width: var(--hairline);
  }

  .series {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark {
    fill: var(--accent);
  }

  .tick,
  .phase,
  .xlabel {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--ink-dim);
  }

  .phase {
    fill: var(--accent);
    font-family: var(--font-sans);
  }

  .chart-data {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-dim);
  }

  .chart-data summary {
    cursor: pointer;
    color: var(--ink-dim);
    transition: color 0.2s var(--ease-out);
  }

  .chart-data summary:hover {
    color: var(--accent);
  }

  .chart-data table {
    margin-top: var(--space-2);
    border-collapse: collapse;
    font-size: var(--fs-mono);
  }

  .chart-data th,
  .chart-data td {
    text-align: left;
    font-weight: 400;
    padding: 0.3rem 1.5rem 0.3rem 0;
    border-bottom: var(--hairline) solid var(--line);
  }
</style>
