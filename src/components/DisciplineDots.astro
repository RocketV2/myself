---
interface Props {
  score: number; // 1-5
}

const { score } = Astro.props;
const n = Math.min(5, Math.max(1, Math.round(score)));
---

<span class="dots" role="img" aria-label={`纪律 ${score} / 5`}>
  <svg viewBox="0 0 92 14" width="92" height="14" aria-hidden="true">
    {Array.from({ length: 5 }, (_, i) => (
      <circle cx={10 + i * 18} cy="7" r="5" class={i < n ? 'dot dot--on' : 'dot'} />
    ))}
  </svg>
</span>

<style>
  .dots {
    display: inline-flex;
    vertical-align: middle;
  }

  .dot {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .dot--on {
    fill: var(--accent);
    stroke: var(--accent);
  }
</style>
