---
interface Props {
  counts: { reflections: number; mentors: number };
}

const { counts } = Astro.props;
---

<section class="signal" data-reveal>
  <div class="container signal-inner">
    <div class="signal-cell">
      <strong>{counts.reflections}</strong>
      <span>感悟 · 篇</span>
    </div>
    <div class="signal-cell">
      <strong>{counts.mentors}</strong>
      <span>语录 · 条</span>
    </div>
  </div>
</section>

<style>
  .signal {
    border-top: var(--hairline) solid var(--line);
    border-bottom: var(--hairline) solid var(--line);
    background: var(--bg-elev);
  }

  .signal-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .signal-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-inline: var(--space-5);
    border-left: var(--hairline) solid var(--line);
  }

  .signal-cell:first-child {
    border-left: none;
    padding-left: 0;
  }

  .signal-cell strong {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }

  .signal-cell span {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-dim);
    letter-spacing: 0.08em;
  }
</style>
