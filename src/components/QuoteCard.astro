---
interface Props {
  href: string;
  name: string;
  alias?: string;
  quote: string;
  source?: string;
  hasMedia?: boolean;
}

const { href, name, alias, quote, source, hasMedia = false } = Astro.props;
---

<li class="quote" data-reveal>
  <a href={href} class="quote-link">
    <blockquote class="quote-text">{quote}</blockquote>
    <footer class="quote-foot">
      <span class="quote-name">
        {name}
        {alias && <span class="quote-alias"> · {alias}</span>}
        {hasMedia && <span class="quote-media" title="含音视频">音</span>}
      </span>
      {source && <span class="quote-source">{source}</span>}
    </footer>
  </a>
</li>

<style>
  .quote {
    list-style: none;
  }

  .quote-link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    height: 100%;
    padding: var(--space-5);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out);
  }

  .quote-link:hover {
    border-color: var(--line-strong);
    background: rgba(232, 230, 225, 0.03);
  }

  .quote-text {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.85;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .quote-text::before {
    content: '「';
    color: var(--accent);
  }

  .quote-text::after {
    content: '」';
    color: var(--accent);
  }

  .quote-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .quote-name {
    font-family: var(--font-serif);
    font-size: var(--fs-small);
    color: var(--ink);
    letter-spacing: 0.06em;
  }

  .quote-alias {
    color: var(--ink-dim);
  }

  .quote-media {
    color: var(--accent);
    margin-left: var(--space-2);
  }

  .quote-source {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-dim);
  }
</style>
