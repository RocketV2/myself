---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/reveal.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '找到自己 · 重塑自己',
  description = '记录每一笔操作与每一分情绪，直到纪律成为本能。日常感悟、A股超短复盘、前辈语录。',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060a" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href={`${base}fonts/serif-400.woff2`}
    />
    <!-- 字体声明在 public/fonts.css（相对 url，天然跟随 base） -->
    <link rel="stylesheet" href={`${base}fonts.css`} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // 滚动揭示：无 JS / 不支持 IntersectionObserver 时内容全部可见
      const revealEls = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -4% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
