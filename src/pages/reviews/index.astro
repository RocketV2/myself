---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import EntryCard from '../../components/EntryCard.astro';
import LineChart from '../../components/charts/LineChart.astro';
import BarChart from '../../components/charts/BarChart.astro';
import { getCollection } from 'astro:content';
import { p } from '../../lib/paths';
import {
  published,
  sortByDateDesc,
  emotionSeries,
  emotionOverview,
  disciplineSeries,
  winRateStats,
  tradeCounts,
  PHASE_VALUE,
} from '../../lib/stats';

const reviews = sortByDateDesc(published(await getCollection('reviews')));
const overview = emotionOverview(reviews);
const winRate = winRateStats(reviews);

const emotion = emotionSeries(reviews);
const emotionTicks = (Object.keys(PHASE_VALUE) as Array<keyof typeof PHASE_VALUE>).map((phase) => ({
  v: PHASE_VALUE[phase] * 10,
  label: phase,
}));

const discipline = disciplineSeries(reviews);
const disciplineTicks = [1, 2, 3, 4, 5].map((v) => ({ v, label: String(v) }));

const rolling = winRate.rolling;
const rateTicks = [0, 25, 50, 75, 100].map((v) => ({ v, label: `${v}%` }));

const trades = tradeCounts(reviews);

const chips = (r: (typeof reviews)[number]) => [
  r.data.type === 'weekly' ? '周复盘' : '日复盘',
  r.data.cyclePhase,
  `${r.data.disciplineScore}/5`,
];
---

<Base title="超短复盘 — 找到自己 · 重塑自己" description="每日、每周 A 股超短复盘：情绪周期、操作与纪律打分，数据不说谎。">
  <div class="container">
    <header class="page-head" data-reveal>
      <p class="kicker">02 · 超短复盘</p>
      <h1>数据不说谎</h1>
      <p class="lede">
        每天收盘后如实记录：情绪周期、最高板、主线、操作与纪律。共 {reviews.length} 篇复盘，曲线会替我复盘自己。
      </p>
    </header>

    <div class="overview" data-reveal>
      <div class="overview-cell">
        <span class="overview-label">当前情绪</span>
        <strong>{overview.phase ?? '—'}</strong>
      </div>
      <div class="overview-cell">
        <span class="overview-label">最高板记录</span>
        <strong>{overview.maxBoard} 板</strong>
      </div>
      <div class="overview-cell">
        <span class="overview-label">总胜率</span>
        <strong class:list={[winRate.rate !== null && winRate.rate >= 50 ? 'is-pos' : 'is-neg']}>
          {winRate.rate !== null ? `${winRate.rate.toFixed(0)}%` : '—'}
        </strong>
        <span class="overview-sub">
          {winRate.total > 0 ? `${winRate.wins} 胜 ${winRate.losses} 负` : '暂无已了结交易'}
        </span>
      </div>
    </div>

    {
      emotion.length > 0 && (
        <section class="chart-section" data-reveal>
          <h2 class="chart-title">情绪周期曲线</h2>
          <p class="chart-note">阶梯越高情绪越热：冰点 - 启动 - 发酵 - 高潮 - 退潮。相位标注在每个转折点。</p>
          <LineChart points={emotion} yTicks={emotionTicks} ariaLabel="情绪周期随时间变化的阶梯曲线" stepped />
        </section>
      )
    }

    {
      discipline.length > 0 && (
        <section class="chart-section" data-reveal>
          <h2 class="chart-title">纪律趋势</h2>
          <p class="chart-note">每篇复盘的纪律自评（1-5），周复盘以「周」标记在点上。这条线比收益率更诚实。</p>
          <LineChart points={discipline} yTicks={disciplineTicks} ariaLabel="纪律打分随时间的折线图" />
        </section>
      )
    }

    {
      rolling.length > 0 && (
        <section class="chart-section" data-reveal>
          <h2 class="chart-title">胜率（7 日滚动）</h2>
          <p class="chart-note">只统计日复盘中已了结的交易；滚动窗口取最近 7 个交易日的平均日胜率。</p>
          <LineChart points={rolling} yTicks={rateTicks} ariaLabel="7 日滚动胜率折线图" />
        </section>
      )
    }

    {
      trades.length > 0 && (
        <section class="chart-section" data-reveal>
          <h2 class="chart-title">交易类型分布</h2>
          <p class="chart-note">打板、半路、低吸、其他 —— 看看钱到底亏在了哪种手法上。</p>
          <BarChart data={trades} ariaLabel="交易类型数量柱状图" />
        </section>
      )
    }

    <section class="chart-section">
      <h2 class="chart-title list-title">全部复盘</h2>
      {
        reviews.length > 0 ? (
          <EntryList>
            {reviews.map((r) => (
              <EntryCard
                href={p(`reviews/${r.id}/`)}
                title={r.data.title}
                date={r.data.date}
                chips={chips(r)}
                excerpt={r.data.marketContext}
              />
            ))}
          </EntryList>
        ) : (
          <p class="empty">还没有复盘。用 npm run new:review daily 开始记录。</p>
        )
      }
    </section>
  </div>
</Base>

<style>
  .overview {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    padding-bottom: var(--space-7);
    border-bottom: var(--hairline) solid var(--line);
    margin-bottom: var(--space-7);
  }

  .overview-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .overview-label {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-dim);
    letter-spacing: 0.08em;
  }

  .overview-cell strong {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    color: var(--accent);
    line-height: 1.1;
  }

  .overview-cell strong.is-pos {
    color: var(--pos);
  }

  .overview-cell strong.is-neg {
    color: var(--neg);
  }

  .overview-sub {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-dim);
  }

  .chart-section {
    margin-top: var(--space-7);
  }

  .chart-title {
    font-size: var(--fs-h2);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .chart-note {
    font-size: var(--fs-small);
    color: var(--ink-dim);
    margin-bottom: var(--space-5);
    max-width: var(--measure);
  }

  .list-title {
    border-top: var(--hairline) solid var(--line);
    padding-top: var(--space-6);
  }

  .empty {
    color: var(--ink-dim);
    padding-block: var(--space-6);
  }
</style>
