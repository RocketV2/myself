---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getCollection } from 'astro:content';
import { p } from '../../lib/paths';
import { published, sortByDateDesc } from '../../lib/stats';

const reviews = sortByDateDesc(published(await getCollection('reviews')));

const chips = (r: (typeof reviews)[number]) => [
  r.data.type === 'weekly' ? '周复盘' : '日复盘',
];
---

<Base title="超短复盘 — 找到自己 · 重塑自己" description="每日、每周 A 股超短复盘：记录大盘数据与涨停个股。">
  <div class="review-page">
    <div class="container">
      <header class="page-head" data-reveal>
        <p class="kicker">02 · 超短复盘</p>
        <h1>数据不说谎</h1>
        <p class="lede">
          每天收盘后如实记录。共 {reviews.length} 篇复盘。
        </p>
      </header>

      <div class="actions" data-reveal>
        <a class="btn-new" href={p('reviews/new/')}>
          <span class="btn-icon">+</span>
          新建复盘
        </a>
      </div>

      <section class="list-section" data-reveal>
        <h2 class="list-title">全部复盘</h2>
        {
          reviews.length > 0 ? (
            <EntryList>
              {reviews.map((r) => (
                <EntryCard
                  href={p(`reviews/${r.id}/`)}
                  title={r.data.title}
                  date={r.data.date}
                  chips={chips(r)}
                  excerpt={r.data.marketContext}
                />
              ))}
            </EntryList>
          ) : (
            <p class="empty">还没有复盘。点击上方按钮新建。</p>
          )
        }
      </section>
    </div>
  </div>
</Base>

<style>
  .review-page {
    /* 护眼模式颜色 — 米黄暖白风 */
    --bg: #f5f0e8;
    --bg-elev: #ede7db;
    --ink: #3c3a36;
    --ink-dim: #7a756c;
    --accent: #b8860b;
    --pos: #3a7d4a;
    --neg: #b84949;
    --line: rgba(60, 58, 54, 0.15);
    --line-strong: rgba(60, 58, 54, 0.28);
    --glow: rgba(184, 134, 11, 0.2);
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
  }

  .actions {
    padding-bottom: var(--space-6);
    border-bottom: var(--hairline) solid var(--line);
    margin-bottom: var(--space-6);
  }

  .btn-new {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--bg);
    background: var(--accent);
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: opacity 0.2s var(--ease-out);
  }

  .btn-new:hover {
    opacity: 0.85;
  }

  .btn-icon {
    font-size: 1.2em;
    line-height: 1;
  }

  .list-title {
    font-size: var(--fs-h2);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-5);
  }

  .empty {
    color: var(--ink-dim);
    padding-block: var(--space-6);
  }

  /* 覆写全局组件颜色 */
  :global(.nav) {
    background: rgba(245, 240, 232, 0.88) !important;
    border-bottom-color: var(--line) !important;
  }

  :global(.footer) {
    border-top-color: var(--line) !important;
  }
</style>