---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SignalStrip from '../components/SignalStrip.astro';
import EntryList from '../components/EntryList.astro';
import EntryCard from '../components/EntryCard.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { getCollection } from 'astro:content';
import { p } from '../lib/paths';
import { pillarCounts, latest, published, type MentorEntry } from '../lib/stats';

const reflections = await getCollection('reflections');
const mentors = await getCollection('mentors');

const counts = pillarCounts(reflections, mentors);

const latestReflections = latest(reflections, 3);
// 语录按日期倒序（无日期的排最后）
const latestMentors: MentorEntry[] = published(mentors)
  .sort(
    (a, b) =>
      (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  )
  .slice(0, 3);
---

<Base>
  <Hero />
  <SignalStrip counts={counts} />

  <!-- 01 · 感悟 -->
  <section id="reflections" class="section container">
    <header class="section-head" data-reveal>
      <span class="sec-no">01</span>
      <h2 class="sec-title">感悟反思</h2>
      <a class="sec-more" href={p('reflections/')}>全部</a>
    </header>
    <EntryList>
      {latestReflections.map((r) => (
        <EntryCard
          href={p(`reflections/${r.id}/`)}
          title={r.data.title}
          date={r.data.date}
          chips={r.data.tags.slice(0, 2)}
          excerpt={r.data.excerpt}
        />
      ))}
    </EntryList>
  </section>

  <!-- 02 · 语录 -->
  <section id="mentors" class="section container">
    <header class="section-head" data-reveal>
      <span class="sec-no">02</span>
      <h2 class="sec-title">前辈语录</h2>
      <a class="sec-more" href={p('mentors/')}>全部</a>
    </header>
    <ol class="quote-grid" data-reveal-group>
      {latestMentors.map((m) => (
        <QuoteCard
          href={p(`mentors/${m.id}/`)}
          name={m.data.name}
          alias={m.data.alias}
          quote={m.data.quote}
          source={m.data.source}
          hasMedia={m.data.media !== undefined}
        />
      ))}
    </ol>
  </section>
</Base>

<style>
  .quote-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 900px) {
    .quote-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
