---
import Prose from '../../layouts/Prose.astro';
import { getCollection, render } from 'astro:content';
import { p } from '../../lib/paths';
import { fmtCN } from '../../lib/dates';
import type { ReflectionEntry } from '../../lib/stats';

export async function getStaticPaths() {
  const reflections = await getCollection('reflections');
  return reflections
    .filter((r) => !r.data.draft)
    .map((r) => ({ params: { slug: r.id }, props: { entry: r } }));
}

const { entry } = Astro.props as { entry: ReflectionEntry };
const { Content } = await render(entry);
---

<Prose title={entry.data.title} description={entry.data.excerpt}>
  <article class="container">
    <header class="article-head" data-reveal>
      <p class="kicker">
        <a href={p('reflections/')}>感悟反思</a>
        <span aria-hidden="true"> / </span>
        <time datetime={entry.data.date.toISOString()}>{fmtCN(entry.data.date)}</time>
        {entry.data.time && (
          <>
            <span aria-hidden="true"> · </span>
            {entry.data.time}
          </>
        )}
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.tags.length > 0 && (
        <p class="article-tags">
          {entry.data.tags.map((t) => (
            <span class="chip">{t}</span>
          ))}
        </p>
      )}
    </header>
    <div class="prose" data-reveal>
      <Content />
    </div>
  </article>
</Prose>

<style>
  .article-head {
    padding-top: calc(var(--nav-h) + var(--space-7));
    padding-bottom: var(--space-6);
    max-width: var(--measure);
  }

  .article-head .kicker a {
    color: var(--accent);
    text-decoration: none;
  }

  .article-head h1 {
    font-size: var(--fs-h1);
    letter-spacing: var(--track-display);
    margin-top: var(--space-4);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
  }
</style>
